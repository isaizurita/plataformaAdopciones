<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<VBox spacing="25" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.adopcion.controller.MainController"
      styleClass="main-bg">
    <!-- Título -->
    <Label text="ADOPTA"
           styleClass="title-main"/>
    <Label text="Un amigo para toda la vida"
           styleClass="subtitle"/>
    <!-- Grid de opciones -->
    <GridPane hgap="20" vgap="20" alignment="CENTER">
        <Button text="Refugios"
                onAction="#abrirRefugios"
                styleClass="card-button"
                GridPane.rowIndex="0"
                GridPane.columnIndex="0"/>
        <Button text="Mascotas"
                onAction="#abrirMascotas"
                styleClass="card-button"
                GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Button text="Adoptantes"
                styleClass="card-button"
                GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Button text="Solicitudes"
                styleClass="card-button"
                GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>
</VBox>