<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" alignment="TOP_CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.adopcion.controller.MascotaController"
      styleClass="main-bg">

    <!-- Título -->
    <Label text="Gestión de Mascotas"
           styleClass="title-main"/>

    <!-- Campos -->
    <TextField fx:id="nombreField" promptText="Nombre"
               styleClass="text-field" maxWidth="700"/>

    <TextField fx:id="especieField" promptText="Especie"
               styleClass="text-field" maxWidth="700"/>

    <TextField fx:id="razaField" promptText="Raza"
               styleClass="text-field" maxWidth="700"/>

    <TextField fx:id="edadField" promptText="Edad"
               styleClass="text-field" maxWidth="700"/>

    <TextField fx:id="refugioIdField" promptText="ID Refugio"
               styleClass="text-field" maxWidth="700"/>

    <!-- Botones -->
    <HBox spacing="20" alignment="CENTER">

        <Button text="Agregar Mascota"
                styleClass="card-button"
                onAction="#agregarMascota"/>

        <Button text="Marcar como Adoptada"
                styleClass="card-button"
                onAction="#marcarAdoptada"/>

        <Button text="Volver"
                styleClass="card-button"
                onAction="#regresar"/>

    </HBox>

    <!-- TABLA GRANDE -->
    <TableView fx:id="tablaMascotas"
               prefHeight="400"
               maxWidth="900"
               VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-background-radius: 10;">

        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
            <TableColumn fx:id="colEspecie" text="Especie" prefWidth="120"/>
            <TableColumn fx:id="colRaza" text="Raza" prefWidth="120"/>
            <TableColumn fx:id="colEdad" text="Edad" prefWidth="80"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
            <TableColumn fx:id="colRefugio" text="ID Refugio" prefWidth="100"/>
            <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="120"/>
        </columns>

    </TableView>

    <!-- Mensajes -->
    <Label fx:id="mensajeLabel"
           style="-fx-text-fill: white; -fx-font-size: 13px;"/>

</VBox>